# ============================================
# SpringVox Solution Limited - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# --- Backend API ---
# URL of your backend API (local dev or production)
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Resend (Email Delivery) ---
# Get your API key from https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@springvox.com

# --- Notifications ---
# Email address to receive contact form and waitlist notifications
WAITLIST_NOTIFY_EMAIL=hello@springvox.ai

# --- Notion (Optional - for waitlist tracking) ---
# Get token from https://www.notion.so/profile/integrations
NOTION_TOKEN=
NOTION_WAITLIST_DB_ID=

# --- SMTP (Alternative to Resend) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Google Analytics ---
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Site URL ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
